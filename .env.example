# Reference only — no real values here, this file is committed.
#
# In production these are set in Coolify: open the application, go to
# "Environment Variables" and add them there. Coolify keeps them in its own
# storage and injects them when the container starts, so they never touch the
# repository or an image layer.
#
# For a local test run:
#   cp .env.example .env      # .env is gitignored
#   docker build -t portfolio .
#   docker run --rm -p 8080:80 --env-file .env portfolio
#
# docker/entrypoint.sh refuses to start if any of these is empty.

# SMTP server of the mailbox that sends the form messages.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587

# Use a dedicated send-only mailbox, not the main account: these credentials sit
# in the container's environment, and a mailbox password would also grant read
# access to the whole inbox.
SMTP_USER=noreply@maik-radke.de
SMTP_PASS=

# Where the contact form delivers to, and the From address of the message.
CONTACT_EMAIL=kontakt@maik-radke.de

# Optional. Defaults to CONTACT_EMAIL when unset — set it only if the envelope
# sender has to differ from the recipient.
# SMTP_FROM=noreply@maik-radke.de
